---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Pinpoint — Local-First Request Profiler & N+1 Engine for Laravel",
  description = "Pinpoint captures DB queries, detects N+1 patterns via runtime hooks, and jumps directly from your terminal to the offending line of code."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&family=Figtree:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Urbanist:wght@400;500;600;700&family=Archivo:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-bg font-sans text-gray-100 selection:bg-brand-accent selection:text-white antialiased">
    <div class="fixed inset-0 grid-pattern pointer-events-none opacity-20 z-0"></div>
    <slot />

    <div
      class="fixed bottom-4 right-4 z-[60] flex max-w-[92vw] flex-wrap items-center gap-1 rounded-lg border border-brand-border bg-brand-card/95 p-1 shadow-lg shadow-black/40 backdrop-blur"
    >
      <span class="px-1.5 text-[10px] uppercase tracking-wider text-gray-500">Body font</span>
      {(
        [
          ['geist', 'Geist'],
          ['inter', 'Inter'],
          ['jakarta', 'Jakarta'],
          ['grotesk', 'Grotesk'],
          ['plex', 'Plex'],
          ['sora', 'Sora'],
          ['manrope', 'Manrope'],
          ['dmsans', 'DM Sans'],
          ['figtree', 'Figtree'],
          ['outfit', 'Outfit'],
          ['urbanist', 'Urban'],
          ['archivo', 'Archivo'],
          ['hanken', 'Hanken'],
          ['schibsted', 'Schibsted'],
        ] as [string, string][]
      ).map(([id, label]) => (
        <button
          data-body-font-pick={id}
          class="rounded-md px-1.5 py-1 text-[11px] font-medium text-gray-400 transition-colors hover:text-white"
        >
          {label}
        </button>
      ))}
    </div>
  </body>
</html>

<style is:global>
  body[data-body-font='geist'] { font-family: 'Geist', Inter, ui-sans-serif, system-ui, sans-serif; }
  body[data-body-font='inter'] { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
  body[data-body-font='jakarta'] { font-family: 'Plus Jakarta Sans', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='grotesk'] { font-family: 'Space Grotesk', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='plex'] { font-family: 'IBM Plex Sans', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='sora'] { font-family: 'Sora', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='manrope'] { font-family: 'Manrope', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='dmsans'] { font-family: 'DM Sans', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='figtree'] { font-family: 'Figtree', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='outfit'] { font-family: 'Outfit', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='urbanist'] { font-family: 'Urbanist', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='archivo'] { font-family: 'Archivo', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='hanken'] { font-family: 'Hanken Grotesk', Inter, ui-sans-serif, sans-serif; }
  body[data-body-font='schibsted'] { font-family: 'Schibsted Grotesk', Inter, ui-sans-serif, sans-serif; }
</style>

<script>
  const bodyEl = document.body;
  const pick = localStorage.getItem('body-font-test') || 'inter';
  bodyEl.setAttribute('data-body-font', pick);
  document.querySelectorAll<HTMLElement>('[data-body-font-pick]').forEach((el) => {
    if (el.dataset.bodyFontPick === pick) {
      el.classList.add('bg-brand-accent', 'text-white');
    }
    el.addEventListener('click', () => {
      const id = el.dataset.bodyFontPick!;
      localStorage.setItem('body-font-test', id);
      bodyEl.setAttribute('data-body-font', id);
      document.querySelectorAll('[data-body-font-pick]').forEach((b) => {
        b.classList.remove('bg-brand-accent', 'text-white');
      });
      el.classList.add('bg-brand-accent', 'text-white');
    });
  });
</script>

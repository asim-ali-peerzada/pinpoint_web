---
import GlowMesh from '../ui/GlowMesh.astro';
import { Copy } from 'lucide-react';

const steps = [
  {
    n: '01',
    rawCmd: 'composer require asimali/pinpoint --dev',
    label: 'Install as a dev dependency',
    html: '<span class="text-brand-accent font-semibold">composer</span> require asimali/pinpoint <span class="text-gray-400">--dev</span>',
  },
  {
    n: '02',
    rawCmd: 'php artisan vendor:publish --tag="pinpoint-migrations" && php artisan migrate',
    label: 'Publish & run migrations',
    html: '<span class="text-brand-accent font-semibold">php artisan</span> vendor:publish <span class="text-gray-400">--tag="pinpoint-migrations"</span> <span class="text-brand-accent/80 font-bold">&amp;&amp;</span> <span class="text-brand-accent font-semibold">php artisan</span> migrate',
  },
  {
    n: '03',
    rawCmd: 'php artisan pinpoint:report',
    label: 'Generate your first latency report',
    html: '<span class="text-brand-accent font-semibold">php artisan</span> pinpoint:report',
  },
];

const table = [
  { dim: 'Focus', t: 'General debugger', p: 'Server health', a: 'Deep profiler', d: 'Route & N+1 latency', dAccent: false },
  { dim: 'N+1 precision', t: 'Manual query counts', p: 'Aggregate counts', a: 'Call graph', d: 'Exact relation', dAccent: true },
  { dim: 'Source location', t: '—', p: '—', a: '—', d: 'Exact file & line', dAccent: true },
  { dim: 'Execution context', t: 'Web dashboard', p: 'Live dashboard', a: 'Cloud SaaS', d: 'CLI & native IDE', dAccent: false },
  { dim: 'Telemetry residency', t: 'In-app', p: 'In-app', a: 'External', d: 'Local-only', dAccent: false },
  { dim: 'Request overhead', t: 'High', p: 'Low', a: 'Varies', d: 'Benchmark-backed', dAccent: false },
];
---

<section id="diff" class="relative py-24">
  <div class="mx-auto max-w-4xl px-4">
    <div class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">Where Pinpoint differs</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl">Built around the Laravel runtime.</h2>
      <p class="mt-4 leading-7 text-brand-muted">
        Pinpoint is for developers who want actionable runtime diagnostics without a heavyweight
        observability stack.
      </p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[640px] border-separate border-spacing-0 text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-widest text-gray-500">
            <th class="py-4 px-3 font-medium border-b border-white/10"></th>
            <th class="py-4 px-3 font-medium border-b border-white/10">Telescope</th>
            <th class="py-4 px-3 font-medium border-b border-white/10">Pulse</th>
            <th class="py-4 px-3 font-medium border-b border-white/10">APM</th>
            <th class="py-4 px-4 font-semibold text-white bg-[#0F1115] border-x border-t-2 border-x-white/[0.08] border-t-brand-accent rounded-t-xl shadow-[0_-4px_16px_rgba(245,48,3,0.15)]">
              Pinpoint
            </th>
          </tr>
        </thead>
        <tbody>
          {table.map((r, idx) => {
            const isLast = idx === table.length - 1;
            return (
              <tr>
                <td class="py-4 px-3 font-medium text-gray-300 border-t border-white/[0.06]">{r.dim}</td>
                <td class="py-4 px-3 text-gray-500 border-t border-white/[0.06]">{r.t}</td>
                <td class="py-4 px-3 text-gray-500 border-t border-white/[0.06]">{r.p}</td>
                <td class="py-4 px-3 text-gray-500 border-t border-white/[0.06]">{r.a}</td>
                <td
                  class={`py-4 px-4 bg-[#0F1115] text-white font-medium border-x border-x-white/[0.08] ${
                    isLast ? 'rounded-b-xl border-b border-b-white/[0.08]' : ''
                  }`}
                >
                  {r.d}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-xs text-gray-600">
      Capabilities cross-referenced against current stable releases. Verify on your own stack —
      that's the point.
    </p>
  </div>
</section>

<section id="docs" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-4xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">04 / Documentation</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl">Start profiling in minutes.</h2>
      <p class="mt-4 leading-7 text-brand-muted">Three commands from zero to actionable latency insight.</p>
    </div>

    <div class="mt-14 space-y-3">
      {steps.map((s) => (
        <div class="group flex items-center justify-between gap-5 rounded-xl border border-white/[0.08] bg-[#0D0F12] p-4 sm:p-5 transition-all duration-200 hover:border-white/[0.16] hover:bg-[#111418]">
          <div class="flex items-center gap-4 sm:gap-5 min-w-0 flex-1">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-brand-accent/25 bg-brand-accent/10 font-mono text-sm font-bold text-brand-accent">
              {s.n}
            </div>
            <div class="min-w-0 flex-1 border-l border-white/10 pl-4 sm:pl-5">
              <p class="text-[11px] font-semibold uppercase tracking-widest text-gray-400">{s.label}</p>
              <div class="mt-1 flex items-center font-mono text-sm text-gray-100 overflow-x-auto">
                <span class="mr-2 select-none text-brand-accent font-semibold">$</span>
                <code class="truncate" set:html={s.html} />
              </div>
            </div>
          </div>
          <button
            data-step-copy={s.rawCmd}
            class="flex items-center justify-center p-1.5 text-gray-500 transition-colors hover:text-white active:scale-95"
            title="Copy command"
            aria-label={`Copy command: ${s.rawCmd}`}
          >
            <Copy data-icon-copy strokeWidth={1.5} class="h-4 w-4" />
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  button[data-step-copy][data-copied='true'] [data-icon-copy] {
    color: theme('colors.brand.success');
  }
</style>

<script>
  function bindStepCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-step-copy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-step-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {}
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.dataset.copied = 'false';
        }, 1600);
      });
    });
  }
  bindStepCopy();
  document.addEventListener('astro:after-swap', bindStepCopy);
</script>

<section id="benchmarks" class="relative py-12">
  <div class="mx-auto max-w-4xl px-4">
    <div class="rounded-lg border border-brand-border bg-brand-card p-8">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <div>
          <p class="text-sm font-semibold text-white">Measured overhead</p>
          <p class="mt-1 text-sm text-brand-muted">Deferred flush keeps users off the critical path.</p>
        </div>
        <div class="flex items-end gap-8">
          <div class="text-center">
            <p class="font-mono text-3xl font-semibold tabular-nums text-white">0.29<span class="text-sm text-gray-500">ms</span></p>
            <p class="mt-1 text-xs text-brand-accent">Pinpoint</p>
          </div>
          <div class="text-center">
            <p class="font-mono text-3xl font-semibold text-gray-400">1420<span class="text-sm text-gray-600">ms</span></p>
            <p class="mt-1 text-xs text-gray-500">api.orders.index</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import GlowMesh from '../ui/GlowMesh.astro';

const steps = [
  { n: '01', cmd: 'composer require asimali/pinpoint --dev', label: 'Install as a dev dependency' },
  { n: '02', cmd: 'php artisan vendor:publish --tag="pinpoint-migrations" && php artisan migrate', label: 'Publish & run migrations' },
  { n: '03', cmd: 'php artisan pinpoint:report', label: 'Generate your first latency report' },
];
---

<section id="docs" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-4xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Quickstart</h2>
      <p class="mt-4 text-gray-400">Three commands from zero to actionable latency insight.</p>
    </div>

    <div class="mt-14 space-y-4">
      {steps.map((s) => (
        <div class="glass-panel flex items-center gap-5 rounded-2xl p-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-accent/10 font-mono text-sm font-bold text-brand-accent ring-1 ring-brand-accent/30">
            {s.n}
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-xs uppercase tracking-wider text-gray-500">{s.label}</p>
            <code class="mt-1 block truncate font-mono text-sm text-gray-200">{s.cmd}</code>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="benchmarks" class="relative py-12">
  <div class="mx-auto max-w-4xl px-4">
    <div class="glass-panel flex flex-col items-center justify-between gap-6 rounded-2xl p-8 sm:flex-row">
      <div>
        <p class="text-sm font-semibold text-white">Measured overhead on a typical route</p>
        <p class="mt-1 text-sm text-gray-400">Deferred flush keeps your users off the critical path.</p>
      </div>
      <div class="flex items-end gap-8">
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-white">0.29<span class="text-sm text-gray-500">ms</span></p>
          <p class="mt-1 text-xs text-brand-accent">Pinpoint</p>
        </div>
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-gray-400">1420<span className="text-sm text-gray-600">ms</span></p>
          <p class="mt-1 text-xs text-gray-500">api.orders.index</p>
        </div>
      </div>
    </div>
  </div>
</section>

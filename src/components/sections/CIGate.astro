---
import { ShieldCheck, Copy } from 'lucide-react';

const flags = [
  { flag: '--fail-on-n1', desc: 'Fail when any request repeats the same SQL 3+ times — Eloquent lazy loads included.' },
  { flag: '--max-queries=20', desc: 'Fail when any request exceeds your query budget.' },
  { flag: '--max-duration-ms=250', desc: 'Fail when a request exceeds your latency SLA.' },
  { flag: '--since=30m', desc: 'Only inspect the current test run, so old samples never false-fail a PR.' },
  { flag: '--json', desc: 'Structured output for PR-bot automation.' },
];

const yaml = `name: Performance Gate
on: [pull_request]

jobs:
  gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
      - name: Run test suite
        run: php artisan test
        env:
          APP_ENV: testing
      - name: Enforce Pinpoint gate
        run: php artisan pinpoint:check --fail-on-n1 --max-queries=20`;
---

<section id="ci" class="relative py-24">
  <div class="mx-auto max-w-5xl px-4">
    <div class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">
        03 / CI Regression Gate
      </p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl">
        Block N+1s before they merge.
      </h2>
      <p class="mt-4 leading-7 text-brand-muted">
        Pinpoint doubles as a regression gate for your pull requests. Run your suite, then let
        <code class="rounded bg-white/[0.06] px-1.5 py-0.5 font-mono text-xs text-brand-accent">pinpoint:check</code>
        fail the build when a PR introduces an N+1 or blows a query budget — with the exact SQL and
        file:line in the output.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-lg border border-brand-border bg-brand-card">
      <div class="border-b border-white/[0.06] px-4 py-2.5">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-gray-400">
          <ShieldCheck class="h-4 w-4 text-brand-accent" />
          From tests to merge gate, one command
        </p>
      </div>

      <div class="grid gap-0 lg:grid-cols-2">
        <!-- Command + flags -->
        <div class="border-b border-white/[0.06] p-6 lg:border-b-0 lg:border-r">
          <div class="flex items-center gap-2.5 rounded-lg border border-brand-border bg-black/40 px-4 py-3 font-mono text-[13px] text-gray-300">
            <span class="text-brand-accent">$</span>
            <span class="truncate">php artisan pinpoint:check --fail-on-n1 --max-queries=20</span>
          </div>

          <dl class="mt-6 space-y-4">
            {flags.map((f) => (
              <div class="border-t border-white/[0.06] pt-4">
                <dt class="font-mono text-[13px] font-medium text-white">{f.flag}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-brand-muted">{f.desc}</dd>
              </div>
            ))}
          </dl>

          <p class="mt-6 text-xs leading-relaxed text-gray-500">
            Exits 0 on pass, 1 on fail. Callers are captured in
            <span class="font-mono">testing</span>/<span class="font-mono">local</span> — run tests
            with <span class="font-mono">APP_ENV=testing</span> so the report pinpoints the exact
            <span class="font-mono">file:line</span>.
          </p>
        </div>

        <!-- Workflow + failure output -->
        <div class="flex flex-col gap-4 p-6">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-2">
            <span class="font-mono text-xs text-gray-500">.github/workflows/tests.yml</span>
            <button
              data-ci-copy={yaml}
              class="flex items-center gap-1.5 rounded-md border border-brand-border px-2.5 py-1 text-[11px] font-medium text-gray-400 transition-colors hover:border-brand-border-active hover:text-white"
              title="Copy workflow"
            >
              <Copy strokeWidth={1.5} class="h-2.5 w-2.5" />
              <span data-ci-copy-text>Copy</span>
            </button>
          </div>
          <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-gray-300">{yaml}</pre>

          <div class="mt-auto rounded-lg border border-rose-500/25 bg-rose-950/20 p-4">
            <p class="flex items-center gap-2 font-mono text-xs font-semibold text-rose-400">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6m0-6 6 6"/></svg>
              FAIL api.orders.index (exit 1)
            </p>
            <p class="mt-3 font-mono text-xs leading-relaxed text-gray-400">
              14× N+1: select * from items where order_id = ?<br />
              at <span class="text-brand-accent">app/Http/Controllers/OrderController.php:84</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  button[data-ci-copy][data-copied='true'] [data-ci-copy-text] {
    color: theme('colors.brand.success');
  }
</style>

<script>
  function bindCICopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-ci-copy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-ci-copy') || '');
        } catch {}
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.dataset.copied = 'false';
        }, 1600);
      });
    });
  }
  bindCICopy();
  document.addEventListener('astro:after-swap', bindCICopy);
</script>

---
import GlowMesh from '../ui/GlowMesh.astro';
---

<section id="ci" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">
      03 / CI Regression Gate
    </p>

    <!-- Punchy Terminal Failure Block -->
    <div class="mx-auto mt-8 max-w-2xl overflow-hidden rounded-xl border border-white/10 bg-[#08090C] shadow-[0_16px_48px_rgba(0,0,0,0.6)] text-left font-mono text-xs sm:text-sm">
      <div class="flex items-center gap-2 border-b border-white/[0.08] bg-[#0C0E12] px-4 py-2.5">
        <div class="h-2.5 w-2.5 rounded-full bg-[#EC6A5E]/80"></div>
        <div class="h-2.5 w-2.5 rounded-full bg-[#F5BF4F]/80"></div>
        <div class="h-2.5 w-2.5 rounded-full bg-[#62C554]/80"></div>
        <span class="ml-2 text-xs text-gray-500 font-sans">GitHub Actions • Terminal</span>
      </div>
      <div class="p-5 sm:p-6 space-y-3 leading-relaxed">
        <div class="text-gray-400">
          <span class="text-gray-500 select-none">$ </span>
          <span class="text-white font-medium">php artisan pinpoint:check --fail-on-n1</span>
        </div>
        <div class="pt-2 text-rose-400 font-bold flex items-center gap-2">
          <span>✗ FAIL</span>
          <span class="text-white">api.orders.index</span>
        </div>
        <div class="pl-4 border-l-2 border-rose-500/40 text-gray-300 space-y-1">
          <div class="text-rose-300 font-medium">1x N+1 · Order::items() · app/Http/Controllers/OrderController.php:34</div>
        </div>
        <div class="text-gray-500 text-xs pt-2">
          exit 1
        </div>
      </div>
    </div>

    <p class="mt-8 text-xl sm:text-2xl font-semibold tracking-tight text-white max-w-2xl mx-auto">
      Runs in your CI. Fails the merge before an N+1 reaches production.
    </p>
  </div>
</section>

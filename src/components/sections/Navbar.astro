---
import Badge from '../ui/Badge.astro';
import { Star, Copy } from 'lucide-react';
---

<header class="fixed top-4 left-0 right-0 z-50 flex justify-center px-4">
  <nav class="glass-panel !bg-white/[0.02] flex w-full max-w-6xl items-center justify-between rounded-full px-4 py-2.5 backdrop-blur-xl">
    <!-- Left: Brand -->
    <div class="flex items-center gap-2.5 pl-2">
      <div class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 ring-1 ring-brand-accent/30">
        <span class="h-2.5 w-2.5 rounded-sm bg-brand-accent"></span>
        <span class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full border-2 border-brand-bg bg-brand-accent shadow-[0_0_8px_rgba(255,45,32,0.6)]">
          <span class="absolute inset-0 animate-ping rounded-full bg-brand-accent/70"></span>
        </span>
      </div>
      <span class="text-sm font-bold tracking-tight text-white">Pinpoint</span>
    </div>

    <!-- Center: Links -->
    <div class="hidden items-center gap-8 text-sm font-medium text-slate-300 md:flex">
      <a href="#features" class="transition-colors hover:text-white">Features</a>
      <a href="#architecture" class="transition-colors hover:text-white">Architecture</a>
      <a href="#benchmarks" class="transition-colors hover:text-white">Benchmarks</a>
      <a href="#docs" class="transition-colors hover:text-white">Documentation</a>
    </div>

    <!-- Right: Command + GitHub -->
    <div class="flex items-center gap-3 sm:gap-4">
      <button
        class="group hidden items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1.5 font-mono text-xs text-gray-300 transition-colors hover:border-brand-accent/40 hover:text-white sm:flex"
        data-copy="composer require asimali/pinpoint"
      >
        <span class="text-brand-accent">$</span>
        <span class="truncate">composer require asimali/pinpoint</span>
        <Copy strokeWidth={1.5} class="hidden -mt-0.5 h-3 w-3 text-gray-400 group-hover:block" />
      </button>
      <a
        href="https://github.com/asimali/pinpoint"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/40 px-3 py-1.5 text-xs text-gray-300 transition-colors hover:border-white/20 hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
        <span class="flex items-center gap-1">
          <Star class="h-3 w-3 fill-amber-400 text-amber-400" /> 1.2k
        </span>
      </a>
    </div>
  </nav>
</header>

  <style>
    button[data-copy][data-copied='true'] svg {
      display: block;
      color: theme('colors.brand.accent');
    }
  </style>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.dataset.copy || '');
        } catch {}
        el.dataset.copied = 'true';
        setTimeout(() => (el.dataset.copied = 'false'), 1500);
      });
    });
  </script>

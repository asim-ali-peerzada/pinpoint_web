---
import { Copy } from 'lucide-react';
import { cn } from '../../lib/cn';

interface Props {
  command?: string;
  class?: string;
}

const { command = 'composer require asimali/pinpoint', class: className } = Astro.props;
---

<div class={cn('group relative', className)}>
  <button
    data-install
    class="inline-flex items-center gap-2.5 rounded-lg border border-brand-border bg-black/40 px-4 py-2.5 font-mono text-sm text-gray-300 transition-colors hover:border-brand-border-active hover:text-white"
  >
    <span class="text-brand-accent">$</span>
    <span class="truncate whitespace-nowrap">{command}</span>
    <Copy data-icon-copy strokeWidth={1.5} class="h-3 w-3 text-gray-500 transition-colors hover:text-white" />
  </button>
</div>

<style>
  button[data-install][data-copied='true'] [data-icon-copy] {
    color: #3FB950;
  }
</style>

<script>
  function bindInstall() {
    document.querySelectorAll<HTMLButtonElement>('[data-install]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.querySelector('span:nth-child(2)')?.textContent?.trim() || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {}
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.dataset.copied = 'false';
        }, 1600);
      });
    });
  }
  bindInstall();
  document.addEventListener('astro:after-swap', bindInstall);
</script>

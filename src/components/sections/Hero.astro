---
import GlowMesh from '../ui/GlowMesh.astro';
import Button from '../ui/Button.astro';
import TerminalPreview from './TerminalPreview.tsx';
import InstallSnippet from './InstallSnippet.astro';
import { ArrowRight } from 'lucide-react';

const meta = ['Laravel 10–13', 'PHP 8.2+', 'MySQL', 'PostgreSQL', 'Local-first'];
---

<section class="relative pt-36 pb-20 sm:pt-44">
  <GlowMesh />

  <div class="relative z-10 mx-auto max-w-5xl px-4 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">
      Laravel Performance Observability
    </p>

    <h1 class="mx-auto mt-5 max-w-3xl text-balance text-5xl font-semibold leading-[1.1] tracking-[-0.02em] text-[#F5F5F5] md:text-7xl">
      Find performance problems
      <br class="hidden sm:block" />
      <span class="font-bold">before your users do.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-[#A1A1AA] md:text-lg">
      Pinpoint instruments Laravel applications at runtime to detect database inefficiencies,
      Eloquent N+1 queries, and route-level latency — without adding production complexity.
    </p>

    <div class="mx-auto mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href="#docs">Get started <ArrowRight class="h-4 w-4" /></Button>
      <Button href="#docs" variant="secondary">Read the documentation</Button>
    </div>

    <div class="mt-4 flex justify-center">
      <InstallSnippet />
    </div>

    <div class="mx-auto mt-20 max-w-5xl">
      <TerminalPreview client:visible />
    </div>

    <div class="mx-auto mt-12 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      {meta.map((m) => (
        <span
          key={m}
          class="rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 py-1 text-xs font-medium text-gray-300 shadow-sm transition-colors hover:border-white/20 hover:text-white"
        >
          {m}
        </span>
      ))}
    </div>

    <div class="mx-auto mt-10 max-w-md">
      <p class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Measured overhead</p>
      <p class="mt-1 font-mono text-sm text-gray-300">
        0.29ms median
        <span class="text-xs text-gray-400">*</span>
        <a href="#benchmarks" class="ml-3 text-brand-accent hover:underline">View benchmarks →</a>
      </p>
      <p class="mt-1 text-[11px] text-gray-400">
        * Standard route workload, Laravel 12 / PHP 8.3. Full methodology on the benchmarks page.
      </p>
    </div>
  </div>
</section>

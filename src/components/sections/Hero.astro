---
import GlowMesh from '../ui/GlowMesh.astro';
import Button from '../ui/Button.astro';
import TerminalPreview from './TerminalPreview.tsx';
import InstallSnippet from './InstallSnippet.astro';
import { ArrowRight } from 'lucide-react';
---

<section class="relative pt-36 pb-24 sm:pt-44">
  <GlowMesh />

  <div class="relative z-10 mx-auto max-w-6xl px-4 text-center">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-red-600/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="mb-8 flex justify-center">
      <a
        href="#docs"
        class="group inline-flex items-center gap-x-2.5 rounded-full border border-white/10 bg-white/[0.03] p-1 pr-3.5 backdrop-blur-md transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:shadow-[0_0_20px_rgba(255,45,32,0.15)]"
      >
        <!-- Micro-Badge with Live Pulse Dot -->
        <span class="inline-flex items-center gap-x-1.5 rounded-full border border-red-500/40 bg-red-500/20 px-2.5 py-0.5 text-xs font-semibold text-white">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-red-400"></span>
          </span>
          v1.0.0 Live
        </span>

        <!-- Announcement Copy -->
        <span class="text-xs font-medium text-gray-300 transition-colors group-hover:text-white">
          Local-First Laravel Performance Engine
        </span>

        <!-- Smooth Sliding Chevron Icon -->
        <svg
          class="h-3.5 w-3.5 text-gray-500 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-white"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 12l4-4-4-4" />
        </svg>
      </a>
    </div>

    <h1 class="font-display mx-auto max-w-4xl text-balance text-5xl font-extrabold leading-[1.08] tracking-[-0.04em] text-white md:text-7xl">
      Stop Guessing Bottlenecks.
      <span class="bg-gradient-to-r from-[#FF3B30] via-[#FF6243] to-[#FF9F0A] bg-clip-text text-transparent">
        Jump straight to the offending line of code.
      </span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base leading-7 tracking-[-0.01em] text-slate-300 md:text-lg">
      Pinpoint catches every database query, detects Eloquent N+1 violations via runtime lifecycle hooks,
      and ranks your routes by p95 latency zero dashboard clutter, zero production overhead.
    </p>

    <div class="mx-auto mt-9 flex max-w-xl flex-col items-center justify-center gap-3 sm:flex-row">
      <InstallSnippet class="w-full sm:flex-1" />
      <Button href="#docs" variant="secondary" class="w-full whitespace-nowrap sm:w-auto">
        Explore Documentation <ArrowRight class="h-4 w-4" />
      </Button>
    </div>

    <div class="mx-auto mt-16 max-w-5xl">
      <TerminalPreview client:visible />
    </div>
  </div>
</section>

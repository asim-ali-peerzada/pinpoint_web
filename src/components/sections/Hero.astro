---
import GlowMesh from '../ui/GlowMesh.astro';
import Button from '../ui/Button.astro';
import TerminalPreview from './TerminalPreview.tsx';
import InstallSnippet from './InstallSnippet.astro';
import { ArrowRight } from 'lucide-react';

const meta = ['Laravel 12–13', 'PHP 8.2+', 'MySQL', 'PostgreSQL', 'Local-first'];
---

<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44">
  <GlowMesh />

  <div class="relative z-10 mx-auto max-w-5xl px-4 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">
      Laravel Performance Observability
    </p>

    <h1 class="mx-auto mt-5 max-w-3xl text-balance text-5xl font-semibold leading-[1.1] tracking-[-0.02em] text-brand-fg md:text-7xl">
      Find performance problems
      <br class="hidden sm:block" />
      <span class="font-bold">before your users do.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-brand-muted md:text-lg">
      Pinpoint instruments Laravel applications at runtime to detect database inefficiencies,
      Eloquent N+1 queries, and route-level latency — without adding production complexity.
    </p>

    <div class="mx-auto mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href="#docs">Get started <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span></Button>
      <Button
        href="https://github.com/asim-ali-peerzada/pinpoint#readme"
        target="_blank"
        rel="noopener"
        variant="secondary"
      >Read the documentation</Button>
    </div>

    <div class="mt-4 flex justify-center">
      <InstallSnippet />
    </div>

    <div class="mx-auto mt-20 max-w-5xl">
      <TerminalPreview client:load />
    </div>

    <div class="mx-auto mt-12 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      {meta.map((m) => (
        <span
          key={m}
          class="rounded-full border border-white/10 bg-white/[0.02] px-3.5 py-1 text-sm font-normal text-gray-400 transition-colors hover:text-gray-200"
        >
          {m}
        </span>
      ))}
    </div>

    <div class="mx-auto mt-10 max-w-md text-center">
      <p class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Measured overhead</p>
      <p class="mt-1 flex items-center justify-center gap-2 text-sm">
        <span class="font-mono font-medium text-brand-fg">0.29<span class="text-gray-500">ms</span></span>
        <span class="text-brand-muted">mean</span>
        <a href="#benchmarks" class="inline-flex items-center gap-1 font-sans font-medium text-brand-accent hover:underline">
          View benchmarks <ArrowRight class="h-4 w-4" />
        </a>
      </p>
    </div>
  </div>
</section>

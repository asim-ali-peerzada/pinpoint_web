---
import GlowMesh from '../ui/GlowMesh.astro';
import { ArrowRight } from 'lucide-react';
---

<section id="features" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-5xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">01 / Core Capabilities</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl">
        Runtime visibility without the runtime tax.
      </h2>
      <p class="mt-4 leading-7 text-brand-muted">
        Pinpoint connects runtime signals to the code responsible for them.
      </p>
    </div>

    <div class="mt-14 overflow-hidden rounded-lg border border-brand-border bg-brand-card">
      <!-- 01 / DETECT -->
      <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-2 lg:gap-12 md:p-10">
        <div>
          <p class="flex items-center gap-3 text-sm font-semibold text-white">
            <span class="font-mono text-xs text-gray-500">01</span>
            <span class="uppercase tracking-[0.14em] text-gray-400">Detect</span>
          </p>
          <h3 class="mt-3 text-xl font-semibold text-brand-fg">
            N+1 and query anomalies
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-brand-muted">
            Find repeated relationship queries before they become production bottlenecks.
            Uses Laravel's native lazy-loading signals, with SQL fingerprinting as a fallback.
          </p>
          <div class="mt-5 flex gap-4 text-xs font-medium text-gray-400">
            <span class="rounded border border-brand-border px-2 py-1">Eloquent signal</span>
            <span class="rounded border border-brand-border px-2 py-1">SQL fingerprint</span>
          </div>
        </div>

        <div class="self-center rounded-md border border-brand-border bg-black/30 p-4 font-mono text-xs">
          <div class="flex items-center justify-between">
            <span class="uppercase tracking-wider text-gray-500">Query pattern</span>
            <span class="rounded px-1.5 py-0.5 text-[10px] font-bold uppercase text-red-300">N+1 detected</span>
          </div>
          <div class="mt-3 text-sm font-medium text-white">Order → items</div>
          <div class="mt-2 grid grid-cols-2 gap-2 text-gray-400">
            <div>14 repeated</div>
            <div>1 relationship</div>
          </div>
        </div>
      </div>

      <div class="border-t border-white/[0.06]"></div>

      <!-- 02 / MEASURE -->
      <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-2 lg:gap-12 md:p-10">
        <div>
          <p class="flex items-center gap-3 text-sm font-semibold text-white">
            <span class="font-mono text-xs text-gray-500">02</span>
            <span class="uppercase tracking-[0.14em] text-gray-400">Measure</span>
          </p>
          <h3 class="mt-3 text-xl font-semibold text-brand-fg">
            Route latency and runtime overhead
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-brand-muted">
            Understand request performance without heavy tracing on the request path.
            Percentile rollups compute in the background, never inline.
          </p>
          <a href="#benchmarks" class="mt-5 inline-flex items-center gap-1 text-xs font-medium text-brand-accent hover:underline">
            Overhead methodology <ArrowRight class="h-3 w-3" />
          </a>
        </div>

        <div class="self-center rounded-md border border-brand-border bg-black/30 p-4 font-mono text-xs">
          <div class="uppercase tracking-wider text-gray-500">Request diagnostics</div>
          <div class="mt-3 grid grid-cols-3 gap-4">
            <div>
              <div class="text-[11px] uppercase tracking-wider text-gray-500">P95</div>
              <div class="mt-0.5 text-sm tabular-nums text-white">1.42s</div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-gray-500">Avg</div>
              <div class="mt-0.5 text-sm tabular-nums text-gray-300">890ms</div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider text-gray-500">Queries</div>
              <div class="mt-0.5 text-sm tabular-nums text-gray-300">42</div>
            </div>
          </div>
          <div class="mt-4 border-t border-white/[0.06] pt-3">
            <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-gray-500">
              <span>Instrumentation overhead</span>
              <span class="text-red-300">+0.29ms median</span>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-white/[0.06]"></div>

      <!-- 03 / LOCATE -->
      <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-2 lg:gap-12 md:p-10">
        <div>
          <p class="flex items-center gap-3 text-sm font-semibold text-white">
            <span class="font-mono text-xs text-gray-500">03</span>
            <span class="uppercase tracking-[0.14em] text-gray-400">Locate</span>
          </p>
          <h3 class="mt-3 text-xl font-semibold text-brand-fg">
            Source-level context
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-brand-muted">
            Move from a slow route directly to the responsible source. Diagnostics stay
            local — no telemetry pipeline, no hosted round trip.
          </p>
        </div>

        <div class="self-center rounded-md border border-brand-border bg-black/30 p-4 font-mono text-xs">
          <div class="uppercase tracking-wider text-gray-500">Source</div>
          <div class="mt-3 text-sm font-medium text-white">OrderController.php:84</div>
          <div class="mt-2 text-gray-400">$order-&gt;items</div>
          <div class="mt-4 flex items-center justify-between border-t border-white/[0.06] pt-3">
            <span class="text-[11px] uppercase tracking-wider text-gray-500">Open in IDE/terminal</span>
            <span class="text-brand-accent">⌘ Click to open source →</span>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-gray-600">
      * Standard route workload, Laravel 12 / PHP 8.3. Methodology described on the benchmarks page.
    </p>
  </div>
</section>

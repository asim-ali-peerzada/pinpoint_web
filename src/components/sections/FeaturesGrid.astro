---
import GlowMesh from '../ui/GlowMesh.astro';
import { GitFork, Zap, Terminal, Layers, Code2 } from 'lucide-react';

const pillars = [
  {
    icon: 'GitFork',
    accent: 'text-brand-accent',
    ring: 'bg-brand-accent/10 ring-brand-accent/30',
    title: 'Dual-Signal N+1 Detection',
    body: "Combines Eloquent's native handleLazyLoadingViolationUsing hook (model + relation name certainty) with CRC32 SQL parameter placeholder collapse as a fallback for raw query builders.",
    badge: 'App\\Models\\Order → items',
  },
  {
    icon: 'Zap',
    accent: 'text-amber-400',
    ring: 'bg-amber-400/10 ring-amber-400/30',
    title: 'Sub-Millisecond Overhead (< 0.29ms)',
    body: 'Heavy stack traces (debug_backtrace) run strictly in local environments with depth caps (DEBUG_BACKTRACE_IGNORE_ARGS). Database writes are deferred to Laravel\'s terminating event, off the request cycle.',
    badge: 'standard 1420ms → pinpoint 1420.29ms',
  },
  {
    icon: 'Terminal',
    accent: 'text-indigo-400',
    ring: 'bg-indigo-400/10 ring-indigo-400/30',
    title: 'Local-First IDE Continuity',
    body: "Built for terminal and VS Code. Local API endpoints (/_pinpoint/api/v1) let your IDE read percentile rollups instantly without waiting on an hourly cron.",
    badge: 'CMD + Click → Jump to Line',
  },
];
---

<section id="features" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Three pillars, one engine</h2>
      <p class="mt-4 text-gray-400">Pinpoint is purpose-built for Laravel teams that care about latency, not dashboards.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {pillars.map((p) => (
        <div class="glass-panel glass-panel-hover group rounded-2xl p-6 transition-all duration-300 hover:border-brand-accent/35">
          <div class={`flex h-11 w-11 items-center justify-center rounded-xl ring-1 ${p.ring}`}>
            {p.icon === 'GitFork' && <GitFork class={`h-5 w-5 ${p.accent}`} />}
            {p.icon === 'Zap' && <Zap class={`h-5 w-5 ${p.accent}`} />}
            {p.icon === 'Terminal' && <Terminal class={`h-5 w-5 ${p.accent}`} />}
          </div>

          <h3 class="mt-5 text-lg font-semibold text-white">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">{p.body}</p>

          <div class="mt-5 inline-flex items-center gap-2 rounded-lg border border-white/10 bg-black/30 px-3 py-1.5 font-mono text-xs text-gray-300">
            {p.icon === 'Terminal' ? <Code2 class="h-3.5 w-3.5 text-indigo-400" /> : <Layers class="h-3.5 w-3.5 text-brand-accent" />}
            {p.badge}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import GlowMesh from '../ui/GlowMesh.astro';
import InteractiveDemo from './InteractiveDemo.tsx';
---

<section id="architecture" class="relative py-24">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-5xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent">03 / Diagnostic Workflow</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[#F5F5F5] sm:text-4xl">
        From runtime signal to source line.
      </h2>
      <p class="mt-4 leading-7 text-[#A1A1AA]">
        See how Pinpoint turns a Laravel performance anomaly into an actionable diagnosis.
      </p>
    </div>

    <div class="mt-14">
      <InteractiveDemo client:visible />
    </div>

    <p class="mt-6 text-center text-xs text-gray-600">
      Detect → Measure → Locate, on a real request. Curious how it compares? See{" "}
      <a href="#diff" class="text-brand-accent hover:underline">where Pinpoint differs →</a>
    </p>
  </div>
</section>

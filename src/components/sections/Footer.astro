---
import { ArrowUpRight, Github, Star, ShieldCheck, Terminal, Heart } from 'lucide-react';

const navigation = {
  product: [
    { label: 'Features', href: '#features' },
    { label: 'Architecture', href: '#architecture' },
    { label: 'Benchmarks', href: '#benchmarks' },
    { label: 'Interactive Terminal', href: '#docs' },
    { label: 'N+1 Query Detection', href: '#features' },
  ],
  resources: [
    { label: 'Documentation', href: '#docs' },
    { label: 'Quickstart Guide', href: '#docs' },
    { label: 'Laravel 10–13 Setup', href: '#docs' },
    { label: 'GitHub Repository', href: 'https://github.com/asimali/pinpoint', external: true },
    { label: 'Packagist Package', href: 'https://packagist.org/packages/asimali/pinpoint', external: true },
  ],
  ecosystem: [
    { label: 'Issue Tracker', href: 'https://github.com/asimali/pinpoint/issues', external: true },
    { label: 'Release Notes', href: 'https://github.com/asimali/pinpoint/releases', external: true },
    { label: 'Contributing Guide', href: 'https://github.com/asimali/pinpoint/blob/main/CONTRIBUTING.md', external: true },
    { label: 'Security Policy', href: 'https://github.com/asimali/pinpoint/blob/main/SECURITY.md', external: true },
    { label: 'MIT License', href: 'https://github.com/asimali/pinpoint/blob/main/LICENSE', external: true },
  ],
};
---

<footer class="relative z-10 mt-32 border-t border-white/[0.08] bg-black/40 backdrop-blur-md">
  <!-- Subtle ambient gradient background glow -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-48 w-full max-w-5xl -translate-x-1/2 bg-brand-accent/[0.04] blur-[100px]"></div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6">
    <!-- Top Grid: Brand + Nav Columns -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-8">
      <!-- Left Column: Brand & Tagline -->
      <div class="space-y-4 lg:col-span-2">
        <div class="flex items-center gap-2.5">
          <div class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 ring-1 ring-brand-accent/30 shadow-[0_0_12px_rgba(255,45,32,0.2)]">
            <span class="h-2.5 w-2.5 rounded-sm bg-brand-accent"></span>
            <span class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full border-2 border-black bg-brand-accent">
              <span class="absolute inset-0 animate-ping rounded-full bg-brand-accent/70"></span>
            </span>
          </div>
          <span class="text-base font-bold tracking-tight text-white">Pinpoint</span>
          <span class="rounded-full border border-emerald-500/30 bg-emerald-950/40 px-2 py-0.5 text-[10px] font-medium text-emerald-400">
            v1.0.0
          </span>
        </div>

        <p class="max-w-sm text-sm leading-relaxed text-gray-400">
          Zero-overhead runtime performance observability and automated Eloquent N+1 detection built specifically for high-throughput Laravel applications.
        </p>

        <!-- Live Status Pill & Package snippet -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.02] px-3 py-1 text-xs text-gray-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]"></span>
            <span>Local-first • 0 telemetry</span>
          </div>

          <a
            href="https://github.com/asimali/pinpoint"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.08] bg-white/[0.02] px-3 py-1 text-xs text-gray-300 transition-colors hover:border-white/20 hover:text-white"
          >
            <Github class="h-3.5 w-3.5" />
            <span>GitHub</span>
            <span class="flex items-center gap-0.5 text-amber-400">
              <Star class="h-2.5 w-2.5 fill-current" /> 1.2k
            </span>
          </a>
        </div>
      </div>

      <!-- Nav Columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-3">
        <!-- Product -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Product</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {navigation.product.map((item) => (
              <li>
                <a href={item.href} class="text-gray-400 transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Resources</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {navigation.resources.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="group inline-flex items-center gap-1 text-gray-400 transition-colors hover:text-white"
                >
                  <span>{item.label}</span>
                  {item.external && (
                    <ArrowUpRight class="h-3 w-3 text-gray-500 opacity-60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white group-hover:opacity-100" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Ecosystem & Open Source -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">Open Source</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {navigation.ecosystem.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="group inline-flex items-center gap-1 text-gray-400 transition-colors hover:text-white"
                >
                  <span>{item.label}</span>
                  {item.external && (
                    <ArrowUpRight class="h-3 w-3 text-gray-500 opacity-60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white group-hover:opacity-100" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-8 text-xs text-gray-400 sm:flex-row">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p>© {new Date().getFullYear()} Pinpoint. MIT Licensed.</p>
        <span class="hidden h-3 w-px bg-white/10 sm:inline-block"></span>
        <p class="text-gray-400">Designed for Laravel 10, 11, 12 &amp; 13.</p>
      </div>

      <div class="flex items-center gap-4 text-gray-400">
        <span class="inline-flex items-center gap-1 text-gray-400">
          Crafted with <Heart class="h-3 w-3 fill-rose-500 text-rose-500" /> for the Laravel community
        </span>
      </div>
    </div>
  </div>
</footer>

---
import { ArrowUpRight, Github } from 'lucide-react';

const navigation = {
  highlights: [
    { label: 'Features', href: '#features' },
    { label: 'Architecture', href: '#architecture' },
    { label: 'Benchmarks', href: '#benchmarks' },
    { label: 'Interactive Terminal', href: '#docs' },
    { label: 'N+1 Query Detection', href: '#features' },
  ],
  resources: [
    { label: 'Documentation', href: 'https://github.com/asim-ali-peerzada/pinpoint#readme', external: true },
    { label: 'Quickstart Guide', href: '#docs' },
    { label: 'Laravel 12–13 Setup', href: 'https://github.com/asim-ali-peerzada/pinpoint#installation', external: true },
    { label: 'Releases & Changelog', href: 'https://github.com/asim-ali-peerzada/pinpoint/releases', external: true },
    { label: 'Packagist Package', href: 'https://packagist.org/packages/asimali/pinpoint', external: true },
  ],
  ecosystem: [
    { label: 'Local-First Engine', href: '#features' },
    { label: 'Zero Telemetry', href: '#features' },
    { label: 'MySQL & PostgreSQL', href: '#architecture' },
    { label: 'Eloquent Query Hooks', href: '#architecture' },
    { label: 'CLI & Native IDE Jump', href: '#docs' },
  ],
  community: [
    { label: 'GitHub Repository', href: 'https://github.com/asim-ali-peerzada/pinpoint', external: true },
    { label: 'Issue Tracker', href: 'https://github.com/asim-ali-peerzada/pinpoint/issues', external: true },
    { label: 'Contributing Guide', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/CONTRIBUTING.md', external: true },
    { label: 'Security Policy', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/SECURITY.md', external: true },
    { label: 'MIT License', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/LICENSE', external: true },
  ],
};
---

<footer class="relative z-10 mt-32 border-t border-white/[0.08] bg-black/60 backdrop-blur-xl">
  <!-- Subtle ambient background glow -->
  <div class="pointer-events-none absolute -top-32 left-1/2 -z-10 h-64 w-full max-w-5xl -translate-x-1/2 bg-brand-accent/[0.05] blur-[120px]"></div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6">
    <!-- Brand Bio Section (Laravel-style) -->
    <div class="flex flex-col items-start gap-4">
      <div class="flex items-center gap-3">
        <div class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-brand-accent/15 ring-1 ring-brand-accent/30 shadow-[0_0_16px_rgba(245,48,3,0.3)]">
          <span class="h-3 w-3 rounded-[3px] bg-brand-accent"></span>
          <span class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full border-2 border-black bg-brand-accent">
            <span class="absolute inset-0 animate-ping rounded-full bg-brand-accent/70"></span>
          </span>
        </div>
        <span class="font-display text-xl font-bold tracking-tight text-white">Pinpoint</span>
        <span class="rounded-full border border-emerald-500/30 bg-emerald-950/40 px-2.5 py-0.5 text-[11px] font-medium text-emerald-400">
          v1.0.0 Stable
        </span>
      </div>

      <p class="max-w-2xl text-sm leading-relaxed text-gray-400">
        Pinpoint is a local-first runtime request profiler and automated Eloquent N+1 detection engine for Laravel applications. Built to catch bottlenecks and database duplicate queries at runtime before they impact production users.
      </p>
    </div>

    <!-- Navigation Columns Grid -->
    <div class="mt-12 grid grid-cols-2 gap-8 border-t border-white/[0.08] pt-12 sm:grid-cols-2 md:grid-cols-4 lg:gap-10">
      <!-- Highlights -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-accent">Highlights</p>
        <ul class="mt-4 space-y-3 text-sm">
          {navigation.highlights.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-accent">Resources</p>
        <ul class="mt-4 space-y-3 text-sm">
          {navigation.resources.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-1 text-gray-400 transition-colors hover:text-white"
              >
                <span>{item.label}</span>
                {item.external && (
                  <ArrowUpRight class="h-3 w-3 text-gray-500 opacity-60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white group-hover:opacity-100" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Ecosystem -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-accent">Ecosystem</p>
        <ul class="mt-4 space-y-3 text-sm">
          {navigation.ecosystem.map((item) => (
            <li>
              <a href={item.href} class="text-gray-400 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-accent">Community</p>
        <ul class="mt-4 space-y-3 text-sm">
          {navigation.community.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-1 text-gray-400 transition-colors hover:text-white"
              >
                <span>{item.label}</span>
                {item.external && (
                  <ArrowUpRight class="h-3 w-3 text-gray-500 opacity-60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white group-hover:opacity-100" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Attribution Bar (Laravel-style) -->
    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/[0.08] pt-8 text-xs text-gray-500 sm:flex-row">
      <p>
        Pinpoint is open-sourced software licensed under the <a href="https://github.com/asim-ali-peerzada/pinpoint/blob/main/LICENSE" class="text-gray-300 hover:text-white underline">MIT license</a>. Laravel is a registered trademark of Taylor Otwell.
      </p>

      <a
        href="https://github.com/asim-ali-peerzada/pinpoint"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-gray-400 transition-colors hover:text-white"
      >
        <Github class="h-4 w-4" />
        <span>View source on GitHub</span>
      </a>
    </div>
  </div>
</footer>

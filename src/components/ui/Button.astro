---
import { cn } from '../../lib/cn';

interface Props {
  href?: string;
  class?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
}

const { href, class: className, variant = 'primary', type = 'button' } = Astro.props;

const variants = {
  primary: 'bg-brand-accent text-white hover:bg-brand-accent/90 shadow-lg shadow-brand-accent/20',
  secondary: 'bg-white/5 text-gray-100 border border-white/10 hover:bg-white/10',
  ghost: 'text-gray-300 hover:text-white',
};

const classes = cn(
  'inline-flex h-11 items-center justify-center gap-2 rounded-xl px-5 text-sm font-semibold transition-all duration-200',
  variants[variant],
  className
);
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}

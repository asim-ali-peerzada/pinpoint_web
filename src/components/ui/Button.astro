---
import { cn } from '../../lib/cn';

interface Props {
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
}

const { href, target, rel, class: className, variant = 'primary', type = 'button' } = Astro.props;

const variants = {
  primary: 'bg-brand-accent text-white hover:bg-brand-accent/90 shadow-[0_1px_3px_rgba(0,0,0,0.12),0_0_20px_rgba(245,48,3,0.25)]',
  secondary: 'bg-transparent text-gray-200 border border-white/10 hover:bg-white/5 hover:border-white/20',
  ghost: 'text-gray-300 hover:text-white',
};

const classes = cn(
  'group inline-flex h-12 items-center justify-center gap-2 rounded-md px-6 font-instrument text-[17px] sm:text-[18px] font-normal tracking-[-0.01em] transition-all duration-200 active:scale-[0.98]',
  variants[variant],
  className
);
---

{href ? (
  <a href={href} target={target} rel={rel} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
